    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, recruiter_email, email_subject, email_body FROM outreach\nWHERE status = 'drafted' AND recruiter_email ~* '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'\nORDER BY id\nLIMIT GREATEST(0, {{ Number($env.DAILY_OUTREACH_LIMIT) || 25 }} - (SELECT count(*) FROM outreach WHERE sent_at > now() - interval '24 hours'))",
        "options": {}
      },
      "id": "78bffa31-53a3-56a1-9c17-e5b253d0008f",
      "name": "Ready to send",
      "type": "n8n-nodes-base.postgres",
