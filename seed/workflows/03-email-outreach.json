      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "e5d3bbfb-28ff-5476-b695-133360141e9a",
      "name": "Manual: draft",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SCRAPER_URL }}/profile",
        "options": {}
      },
      "id": "50161999-efd6-528a-9170-4ab1444ad4ea",
      "name": "Get profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT j.id, j.title, j.company, j.description, j.full_text, j.recruiter_name, j.author_name, j.recruiter_email\nFROM jobs j\nWHERE j.status = 'qualified' AND j.recruiter_email IS NOT NULL AND j.recruiter_email NOT ILIKE '%example.com'\n  AND NOT EXISTS (SELECT 1 FROM outreach o WHERE o.job_id = j.id)\n  AND NOT EXISTS (SELECT 1 FROM outreach o WHERE lower(o.recruiter_email) = lower(j.recruiter_email) AND o.created_at > now() - interval '30 days')\nORDER BY j.match_score DESC NULLS LAST LIMIT {{ Number($env.DAILY_OUTREACH_LIMIT) || 25 }}",
        "options": {}
      },
      "id": "8ae1fb0b-8896-5697-abc8-c3ca00edc1c6",
      "name": "Eligible jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "afPostgres",
          "name": "AutoForge Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const keys = $env.GEMINI_API_KEYS.split(',').map(s => s.trim()).filter(Boolean);\n\nconst p = $('Get profile').first().json;\nconst seen = new Set(); const out = [];\nfor (const { json: j } of $input.all()) {\n  if (seen.has(j.recruiter_email)) continue; seen.add(j.recruiter_email);\n  const key = keys[Math.floor(Math.random() * keys.length)];\n  const who = j.recruiter_name || j.author_name || 'the hiring team';\n  const prompt = `Write a short, professional outreach email (under 100 words, plain text, no placeholders) from ${p.name} to ${who} about this opening.\nCandidate: ${p.title}; ${p.summary}\nPhone: ${p.contact.phone}\nOpening: ${j.title} at ${j.company}. ${(j.description || j.full_text || '').slice(0, 1500)}\nHighlight the most relevant automation experience (Playwright, Cypress, TypeScript). Sign off with the candidate's name.\nReturn JSON only: {\"subject\": \"...\", \"body\": \"...\"}`;\n  out.push({ json: { id: j.id, email: j.recruiter_email, name: p.name, key, body: { contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.3 } } } });\n}\nreturn out;"
      },
      "id": "23461f7d-8cd5-50a2-a082-a8572ba390eb",
      "name": "Build draft prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.AI_MODEL }}:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $json.key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 4000
            }
          }
        }
      },
      "id": "7d523b47-abf9-5df0-96ab-331ebae0e167",
      "name": "Gemini draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nlet r; try { r = JSON.parse(raw.replace(/^```json|```$/g, '').trim()); } catch (e) { r = null; }\nconst src = $('Build draft prompt').item.json;\nconst subject = r?.subject || 'Automation Engineering Role Inquiry';\nconst bodyText = r?.body || `Hi,\\n\\nI am interested in your open role. I bring strong Playwright and TypeScript expertise.\\n\\nBest,\\n${src.name}`;\nreturn { json: { params: [src.id, src.email, subject, bodyText] } };",
        "mode": "runOnceForEachItem"
      },
      "id": "a31a0dc4-1472-5dc6-8177-acbd250b4abf",
      "name": "Parse draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO outreach (job_id, recruiter_email, email_subject, email_body) VALUES ($1, $2, $3, $4) ON CONFLICT (job_id) DO NOTHING",
        "options": {
          "queryReplacement": "={{ $json.params }}"
        }
      },
      "id": "808de75f-6e97-505a-ab0b-3bba96d0f910",
      "name": "Save draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "afPostgres",
          "name": "AutoForge Postgres"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "id": "c736beeb-b68e-5863-8257-46b128dc2848",
      "name": "Schedule: send",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {},
      "id": "e0880a90-8d1d-5636-b6f5-86640538250f",
      "name": "Manual: send",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        560
