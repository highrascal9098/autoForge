# Database
DATABASE_URL=sqlite:///jobs.db

# AI Configuration (Google Generative AI - Multiple keys supported for rate-limit rotation)
GEMINI_API_KEY=xx
GEMINI_API_KEY_2=xx
GEMINI_API_KEYS=xx
AI_MODEL=gemini-3.5-flash-lite

# Gmail Integration (for outreach & reply monitoring)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# LinkedIn Authentication (Persistent Browser Profile Directory)
LINKEDIN_USER_DATA_DIR=scraper/browser_profile
LINKEDIN_STORAGE_STATE=scraper/storage_state.json

# Automation Settings
DRY_RUN=true
DAILY_OUTREACH_LIMIT=75
